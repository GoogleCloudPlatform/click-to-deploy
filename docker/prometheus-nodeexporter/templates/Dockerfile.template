{{- $nodeexporter := index .Packages "nodeexporter" }}
FROM docker.io/library/golang:1.26-bookworm AS builder

ENV NODEEXPORTER_VERSION {{ $nodeexporter.Version }}

RUN set -x && \
    mkdir -p /out && \
    git clone --depth 1 --branch "v${NODEEXPORTER_VERSION}" https://github.com/prometheus/node_exporter.git /src/node_exporter && \
    cd /src/node_exporter && \
    go get golang.org/x/crypto@v0.52.0 && \
    go mod tidy && \
    CGO_ENABLED=0 go build -buildvcs=false -tags netgo \
      -ldflags="-s -w -X github.com/prometheus/common/version.Version=${NODEEXPORTER_VERSION}" \
      -o /out/node_exporter .

FROM {{ .From }}

ENV NODEEXPORTER_VERSION {{ $nodeexporter.Version }}

ENV C2D_RELEASE=${NODEEXPORTER_VERSION}

ENV NODEEXPORTER_URL="https://github.com/prometheus/node_exporter/releases/download/v$NODEEXPORTER_VERSION/node_exporter-$NODEEXPORTER_VERSION.linux-amd64.tar.gz"

RUN set -x && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && \
    apt-get install -qq -y wget && \
    apt-get install -y --only-upgrade libgnutls30 libpcre2-8-0 perl perl-base zlib1g && \
    mkdir nodeexporter-files && cd nodeexporter-files && \
    wget -O nodeexporter.tar.gz "$NODEEXPORTER_URL" && \
    tar xfvz nodeexporter.tar.gz --strip-components=1 && \
    mkdir -p /usr/share/doc/nodeexporter && \
    mv LICENSE /usr/share/doc/nodeexporter && \
    cd - && rm -r nodeexporter-files && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/node_exporter /bin/node_exporter

EXPOSE      9100
USER        nobody
ENTRYPOINT  [ "/bin/node_exporter" ]

