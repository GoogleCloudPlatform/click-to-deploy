{{- $harbor := index .Packages "harbor" -}}

FROM {{ .From }}

# Patch critical CVEs in base OS layer
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --only-upgrade \
        libpcre2-8-0 \
        perl \
        perl-base \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

ENV C2D_RELEASE {{ $harbor.Version }}
